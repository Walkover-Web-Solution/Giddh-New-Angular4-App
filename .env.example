# Example Environment Variables
# Copy this file to .env.local, .env.stage, or .env.prod and fill in your actual values
# DO NOT commit files with real secrets to version control

# Application URLs
APP_URL=http://localhost:3000/
API_URL=https://apitest.giddh.com/
UK_API_URL=https://gbapi.giddh.com/
PORTAL_URL=https://testportal.giddh.com/

# Application Configuration
APP_FOLDER=
ERRLYTIC_NEEDED=false
ERRLYTIC_KEY=your-errlytic-key

# Feature Flags
ENABLE_VOUCHER_ADJUSTMENT_MULTI_CURRENCY=true

# External Service Keys
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
RAZORPAY_KEY=your-razorpay-key
OTP_WIDGET_ID=your-otp-widget-id
OTP_TOKEN_AUTH=your-otp-token-auth
