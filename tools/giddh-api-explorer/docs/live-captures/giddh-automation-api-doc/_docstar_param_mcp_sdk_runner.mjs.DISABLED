#!/usr/bin/env node
/** Bulk param apply via DocStar MCP SDK (requires valid MCP session). */
import fs from 'node:fs';
import path from 'node:path';
import { Client } from '@modelcontextprotocol/sdk/client/index.js';
import { StreamableHTTPClientTransport } from '@modelcontextprotocol/sdk/client/streamableHttp.js';
import { buildUpdateArgs } from './_docstar_param_mcp_driver.mjs';

const ROOT = path.dirname(new URL(import.meta.url).pathname);
const BATCH_DIR = path.join(ROOT, '.docstar-param-batches');
const PROGRESS = path.join(ROOT, '.docstar-param-run-progress.mcp.json');
const PROGRESS_MIRROR = path.join(ROOT, '.docstar-param-run-progress.json');
const SUMMARY = path.join(ROOT, 'docstar-param-doc-upload-summary.json');
const MCP_URL = process.env.DOCSTAR_MCP_URL || 'https://mcp.docstar.io/mcp';
const PACE_MS = Number(process.env.PACE_MS || 120);
const ORG = '83427';
const COLLECTION = '-Jey39dCAAyx';
const ROOT_PARENT = 'u9XDYe5Zc_ds';

function loadItems() {
  return fs
    .readdirSync(BATCH_DIR)
    .filter((f) => f.startsWith('batch-') && f.endsWith('.json'))
    .sort()
    .flatMap((f) => JSON.parse(fs.readFileSync(path.join(BATCH_DIR, f), 'utf8')));
}

function loadProgress() {
  return JSON.parse(fs.readFileSync(PROGRESS, 'utf8'));
}

function saveProgress(p) {
  const body = JSON.stringify(p, null, 2);
  fs.writeFileSync(PROGRESS, body);
  fs.writeFileSync(PROGRESS_MIRROR, body);
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function callUpdate(client, args) {
  const res = await client.callTool({ name: 'update_endpoint', arguments: args });
  const text = res.content?.find((c) => c.type === 'text')?.text;
  if (text) {
    try {
      const data = JSON.parse(text);
      if (data.message && /invalid|error|403|401/i.test(String(data.message))) {
        return { ok: false, error: data };
      }
      if (data.id) return { ok: true, data };
    } catch {
      /* fall through */
    }
  }
  if (res.isError) {
    return { ok: false, error: res };
  }
  return { ok: true, data: res.structuredContent ?? res };
}

async function main() {
  const items = loadItems();
  let progress = loadProgress();
  progress.total = items.length;
  const start = progress.nextIndex ?? 0;

  const transport = new StreamableHTTPClientTransport(new URL(MCP_URL));
  const client = new Client({ name: 'giddh-param-bulk', version: '1.0.0' });
  await client.connect(transport);

  for (let i = start; i < items.length; i++) {
    const item = items[i];
    const args = buildUpdateArgs(item);
    const endpointId = args.endpointId;
    const prevOk = progress.ok;
    try {
      const result = await callUpdate(client, args);
      if (result.ok) {
        progress.ok += 1;
        if (!progress.updatedIds.includes(endpointId)) {
          progress.updatedIds.push(endpointId);
        }
      } else {
        progress.failed.push({
          endpointId,
          catalogKey: item.catalogKey,
          error: result.error,
        });
      }
    } catch (e) {
      progress.failed.push({ endpointId, catalogKey: item.catalogKey, error: String(e) });
    }
    progress.nextIndex = i + 1;
    if (progress.nextIndex % 25 === 0 || progress.nextIndex === items.length) {
      progress.lastCheckpointAt = new Date().toISOString();
      saveProgress(progress);
      console.log(`checkpoint nextIndex=${progress.nextIndex} ok=${progress.ok} failed=${progress.failed.length}`);
    }
    if (i === start && progress.ok === prevOk && progress.failed.length > 0) {
      console.error('First item failed — aborting (likely MCP auth).');
      saveProgress(progress);
      process.exit(3);
    }
    await sleep(PACE_MS);
  }

  saveProgress(progress);

  const pageIds = [...new Set([...progress.updatedIds, ROOT_PARENT])];
  let publish = null;
  if (progress.ok > 0) {
    try {
      const pub = await client.callTool({
        name: 'publish_pages',
        arguments: { orgId: ORG, collectionId: COLLECTION, rootParentId: ROOT_PARENT, pageIds },
      });
      publish = pub;
    } catch (e) {
      publish = { error: String(e) };
    }
  }

  const summary = {
    completedAt: new Date().toISOString(),
    updateMethod: 'user-docstar MCP update_endpoint',
    orgId: ORG,
    collectionId: COLLECTION,
    rootParentId: ROOT_PARENT,
    total: items.length,
    ok: progress.ok,
    failedCount: progress.failed.length,
    failed: progress.failed,
    updatedIds: progress.updatedIds,
    nextIndex: progress.nextIndex,
    publish,
  };
  fs.writeFileSync(SUMMARY, JSON.stringify(summary, null, 2));
  console.log(JSON.stringify({ ok: progress.ok, failed: progress.failed.length, nextIndex: progress.nextIndex }));
}

main().catch((e) => {
  console.error(e);
  process.exit(1);
});
