#!/usr/bin/env node
/**
 * Mark next N batch items as failed with a fixed error (when MCP returns same error for all).
 * Use only when update_endpoint was attempted for each id in order.
 * node _docstar_param_mcp_bulk_fail.mjs <count> "<error message>"
 */
import fs from 'node:fs';
import path from 'node:path';

const ROOT = path.dirname(new URL(import.meta.url).pathname);
const BATCH_DIR = path.join(ROOT, '.docstar-param-batches');
const PROGRESS = path.join(ROOT, '.docstar-param-run-progress.json');

const count = Number(process.argv[2] || 1);
const errorMsg = process.argv[3] || 'update failed';

const items = fs
  .readdirSync(BATCH_DIR)
  .filter((f) => f.startsWith('batch-') && f.endsWith('.json'))
  .sort()
  .flatMap((f) => JSON.parse(fs.readFileSync(path.join(BATCH_DIR, f), 'utf8')));

const progress = JSON.parse(fs.readFileSync(PROGRESS, 'utf8'));
const start = progress.nextIndex ?? 0;
const results = [];
for (let i = 0; i < count && start + i < items.length; i++) {
  const item = items[start + i];
  results.push({ endpointId: item.endpointId, catalogKey: item.catalogKey, ok: false, error: errorMsg });
}
const prevOk = progress.ok;
for (const r of results) {
  progress.failed.push(r);
}
progress.nextIndex = start + results.length;
if (Math.floor(progress.ok / 25) > Math.floor(prevOk / 25)) {
  progress.lastCheckpointAt = new Date().toISOString();
}
fs.writeFileSync(PROGRESS, JSON.stringify(progress, null, 2));
console.log(JSON.stringify({ recorded: results.length, nextIndex: progress.nextIndex, ok: progress.ok, failed: progress.failed.length }));
