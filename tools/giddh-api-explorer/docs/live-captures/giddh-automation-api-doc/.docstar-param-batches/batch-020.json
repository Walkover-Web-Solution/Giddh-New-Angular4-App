  {
    "endpointId": "On2jHzAxoJht",
    "name": "Get Receipts",
    "catalogKey": "POST /company/{companyUniqueName}/advance-receipt/get-all",
    "args": {
      "orgId": "83427",
      "endpointId": "On2jHzAxoJht",
      "description": "List or aggregate vouchers for the company. Put type, dates, pagination, sort, search, branch, and voucherVersion on the query string. Optional filter fields go in the JSON body — do not send type only in the body. Part of the Get All APIs in Giddh. Requires Auth-Key or Session-Id.",
      "params": {
        "branchUniqueName": {
          "checked": "true",
          "value": "",
          "description": "Branch uniqueName; omit for default company branch behaviour. Optional.",
          "required": false
        },
        "page": {
          "checked": "true",
          "value": "1",
          "description": "Page number (1-based). Default: 1. Optional.",
          "required": false
        },
        "count": {
          "checked": "true",
          "value": "50",
          "description": "Page size. Default: 50. Optional.",
          "required": false
        },
        "from": {
          "checked": "true",
          "value": "",
          "description": "Range start date (dd-MM-yyyy). Optional.",
          "required": false
        },
        "to": {
          "checked": "true",
          "value": "",
          "description": "Range end date (dd-MM-yyyy). Optional.",
          "required": false
        },
        "sort": {
          "checked": "true",
          "value": "",
          "description": "Sort direction. Allowed values: asc, desc. Optional.",
          "required": false
        },
        "sortBy": {
          "checked": "true",
          "value": "",
          "description": "Field to sort by. Allowed values: voucherDate, dueDate, voucherNumber. Optional.",
          "required": false
        },
        "q": {
          "checked": "true",
          "value": "",
          "description": "Search text. Optional.",
          "required": false
        },
        "type": {
          "checked": "true",
          "value": "sales",
          "description": "Voucher or list type. Send on the query string, not in the JSON body. Allowed values: sales, invoice, payment, receipt, credit note, debit note. Default: sales. Optional.",
          "required": false
        },
        "voucherVersion": {
          "checked": "true",
          "value": "2",
          "description": "Use 2 for accounting-microservice voucher APIs (same as Giddh panel). Default: 2. Optional.",
          "required": false
        },
        "invoiceCount": {
          "checked": "true",
          "value": "",
          "description": "Related invoice count hint for invoice list queries. Optional.",
          "required": false
        },
        "noteType": {
          "checked": "true",
          "value": "",
          "description": "Credit/debit note subtype when type is a note list. Optional.",
          "required": false
        },
        "mail": {
          "checked": "true",
          "value": "false",
          "description": "When true, trigger mail export. Default: false. Optional.",
          "required": false
        }
      },
      "body": {
        "type": "JSON",
        "raw": {
          "rawType": "JSON",
          "value": "{\n  \"page\": 0,\n  \"count\": 0\n}"
        }
      },
      "bodyDescription": {
        "page": {
          "type": "string",
          "description": "Page number (1-based). Optional.",
          "value": 0
        },
        "count": {
          "type": "string",
          "description": "Page size. Optional.",
          "value": 0
        }
      }
    }
