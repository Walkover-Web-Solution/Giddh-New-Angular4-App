{
    "appId": "com.giddh.prod",
    "electronVersion": "32.2.6",
    "publish": [
        {
            "provider": "s3",
            "bucket": "giddh-app-builds"
        }
    ],
    "directories": {
        "buildResources": "resources",
        "output": "../../../dist/apps/electrongiddh-packages"
    },
    "mac": {
        "category": "public.app-category.finance",
        "target": [
            {
                "target": "dmg",
                "arch": ["universal"]
            },
            {
                "target": "zip", 
                "arch": ["universal"]
            }
        ],
        "icon": "icon.png",
        "hardenedRuntime": false,
        "gatekeeperAssess": false,
        "type": "development",
        "artifactName": "${productName}-${version}.${ext}"
    },
    "dmg": {
        "sign": false,
        "artifactName": "${productName}-${version}.${ext}",
        "title": "${productName} ${version}",
        "icon": "icon.png",
        "iconSize": 80,
        "contents": [
            {
                "x": 130,
                "y": 220
            },
            {
                "x": 410,
                "y": 220,
                "type": "link",
                "path": "/Applications"
            }
        ],
        "window": {
            "width": 540,
            "height": 380
        }
    },
    "asar": true
}
