{
    "appId": "com.giddh.prod",
    "electronVersion": "39.2.7",
    "productName": "giddh",
    "icon": "resources/icon",
    "publish": [
        {
            "provider": "s3",
            "bucket": "giddh-app-builds"
        }
    ],
    "directories": {
        "buildResources": "resources",
        "output": "../electrongiddh-packages"
    },
    "afterSign": "./../../../electron-sign/notarize.js",
    "mac": {
        "category": "public.app-category.finance",
        "target": [
            "dmg",
            "zip"
        ],
        "identity": "Walkover Web Solutions Private Limited (F3U6Z5L2EJ)",
        "type": "distribution",
        "entitlements": "./../../../electron-sign/default.entitlements.mas.plist",
        "entitlementsInherit": "./../../../electron-sign/default.entitlements.mas.inherit.plist",
        "provisioningProfile": "./../../../electron-sign/embedded.provisionprofile",
        "icon": "icon.png",
        "hardenedRuntime": true,
        "gatekeeperAssess": false
    },
    "dmg": {
        "sign": false
    },
    "mas": {
        "entitlements": "./../../../electron-sign/default.entitlements.mas.plist",
        "entitlementsInherit": "./../../../electron-sign/default.entitlements.mas.inherit.plist",
        "provisioningProfile": "./../../../electron-sign/embedded.provisionprofile"
    },
    "linux": {
        "icon": "icon.png",
        "maintainer": "Walkover Technologies Pvt Ltd",
        "target": [
            "AppImage",
            "snap",
            "zip"
        ]
    },
    "win": {
        "target": [
            {
                "target": "nsis",
                "arch": ["x64", "ia32"]
            },
            "zip"
        ],
        "icon": "resources/icon",
        "legalTrademarks": "",
        "signAndEditExecutable": false,
        "requestedExecutionLevel": "asInvoker",
        "artifactName": "${productName}-${version}-${arch}.${ext}",
        "verifyUpdateCodeSignature": false
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "menuCategory": "Accounting",
        "shortcutName": "Giddh",
        "perMachine": false,
        "installerIcon": "resources/icon",
        "uninstallerIcon": "resources/icon",
        "installerHeaderIcon": "resources/icon",
        "deleteAppDataOnUninstall": false,
        "runAfterFinish": true,
        "differentialPackage": false,
        "packElevateHelper": false,
        "allowElevation": false,
        "installerSidebar": "resources/icon"
    },
    "asar": true,
    "asarUnpack": [
        "**/*.node",
        "**/build/icons/*.png"
    ],
    "extraResources": [
        {
            "from": "resources",
            "to": "resources",
            "filter": ["**/*"]
        },
        {
            "from": "build/icons",
            "to": "build/icons",
            "filter": ["**/*"]
        }
    ]
}
