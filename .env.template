# Giddh Environment Variables Template
# Copy this file to create environment-specific .env files
# Example: cp .env.template .env.local

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application URL (where the app is hosted)
APP_URL=http://localhost:3000/

# API Configuration
API_URL=https://apitest.giddh.com/
UK_API_URL=https://gbapi.giddh.com/

# Portal URL
PORTAL_URL=https://testportal.giddh.com/

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OTP Service Configuration
OTP_WIDGET_ID=your-otp-widget-id-here
OTP_TOKEN_AUTH=your-otp-token-auth-here

# Payment Gateway Configuration
RAZORPAY_KEY=your-razorpay-key-here

# =============================================================================
# ENVIRONMENT FLAGS
# =============================================================================

# Environment Type
PRODUCTION_ENV=false
STAGING_ENV=false
LOCAL_ENV=true
TEST_ENV=false

# =============================================================================
# ELECTRON SPECIFIC (for desktop app)
# =============================================================================

# Electron Development Flag
ELECTRON_IS_DEV=true

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Analytics and Tracking
ANALYTICS_ENABLED=false
ANALYTICS_KEY=

# Error Reporting
ERROR_REPORTING_ENABLED=false
ERROR_REPORTING_KEY=

# Feature Flags
ENABLE_BETA_FEATURES=false
ENABLE_DEBUG_MODE=true

# =============================================================================
# SECURITY CONFIGURATIONS
# =============================================================================

# JWT Configuration (if applicable)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY=24h

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# =============================================================================
# DATABASE CONFIGURATION (if applicable)
# =============================================================================

# Database URL (if using local database)
DATABASE_URL=

# Redis Configuration (if using caching)
REDIS_URL=

# =============================================================================
# INSTRUCTIONS
# =============================================================================

# 1. Copy this file to create environment-specific configurations:
#    - .env.local (for local development)
#    - .env.test (for testing environment)
#    - .env.stage (for staging environment)
#    - .env.prod (for production environment)
#    - .env.electron (for electron desktop app)

# 2. Replace all placeholder values with actual configuration values

# 3. Never commit actual .env files to version control

# 4. Add .env.* to your .gitignore file (except .env.template)

# 5. Ensure all team members have the required environment variables
