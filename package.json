{
  "name": "giddh-workspaces",
  "version": "8.2.3",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "npm run postinstall.web && node scripts/build-env.js local && ng serve web-giddh --configuration=local",
    "build": "npm run postinstall.web && node scripts/build-env.js local && ng build web-giddh --configuration=local",
    "build-prod": "npm run postinstall.web && node scripts/build-env.js prod && ng build web-giddh --configuration=prod --output-hashing=all && node tools/web/postbuild --path=dist/apps/web-giddh && npm run rm_bak_files",
    "build-stage": "npm run postinstall.web && node scripts/build-env.js stage && ng build web-giddh --configuration=stage --output-hashing=all && node tools/web/postbuild --path=dist/apps/web-giddh && npm run rm_bak_files",
    "build-test": "npm run postinstall.web && node scripts/build-env.js test && ng build web-giddh --configuration=test --output-hashing=all && node tools/web/postbuild --path=dist/apps/web-giddh && npm run rm_bak_files",
    "bundle:report": "source-map-explorer dist/apps/web-giddh-prod/*.js",
    "rm_bak_files": "find dist -name '*.bak' -exec rm -Rf {} \\;",
    "test": "npm run postinstall.web && ng test",
    "lint": "nx lint && ng lint",
    "e2e": "npm run postinstall.web && ng e2e",
    "clean": "npx rimraf hooks node_modules package-lock.json && npm i",
    "postinstall.web": "node tools/web/postinstall",
    "postinstall.electron": "node tools/electron/postinstall",
    "prepare": "husky install",
    "prepare.electron.giddh": "npm run postinstall.electron && tsc -p apps/electron-giddh/tsconfig.json"
  },
  "dependencies": {
    "@angular/animations": "^21.0.4",
    "@angular/cdk": "^21.0.4",
    "@angular/common": "^21.0.4",
    "@angular/compiler": "^21.0.4",
    "@angular/core": "^21.0.4",
    "@angular/forms": "^21.0.4",
    "@angular/localize": "^21.0.4",
    "@angular/material": "^21.0.4",
    "@angular/platform-browser": "^21.0.4",
    "@angular/platform-browser-dynamic": "^21.0.4",
    "@angular/router": "^21.0.4",
    "@giddh-workspaces/scss": "file:libs/scss",
    "@giddh-workspaces/utils": "file:libs/utils",
    "@giddh-workspaces/web": "file:xplat/web",
    "@ngrx/component-store": "^21.0.0-beta.0",
    "@ngrx/effects": "^21.0.0-beta.0",
    "@ngrx/operators": "^20.1.0",
    "@ngrx/router-store": "^21.0.0-beta.0",
