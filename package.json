    "ngx-clipboard": "^16.0.0",
    "ngx-lightbox": "^3.0.0",
    "ngx-mat-select-search": "^8.0.4",
    "ngx-plaid-link": "^14.0.0",
    "ngx-quicklink": "^0.4.9",
    "ngx-toastr": "^19.1.0",
    "path-browserify": "^1.0.1",
    "print-js": "^1.6.0",
    "qz-tray": "^2.2.3",
    "reflect-metadata": "^0.1.13",
    "reselect": "^4.1.8",
    "rxjs": "^7.8.1",
    "tributejs": "^5.1.3",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.0.0-beta.1",
    "@angular-devkit/build-angular": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.4",
    "@angular/language-service": "^21.0.4",
    "@types/file-saver": "^2.0.1",
    "@types/jquery": "^3.5.21",
    "@types/node": "^18.16.0",
    "colorette": "^2.0.19",
    "compression-webpack-plugin": "^10.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "electron": "^25.3.1",
    "electron-builder": "^24.6.3",
    "electron-installer-dmg": "^4.0.0",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^4.4.8",
    "electron-oauth": "git+https://github.com/govi2010/electron-oauth2.git",
    "electron-packager": "^17.1.1",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^1.5.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.1",
    "husky": "^8.0.3",
    "js-yaml": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.1",
    "typescript": "~5.9.0",
    "webpack": "^5.94.0"
  },
  "xplat": {
    "prefix": "foo"
  }
}
