    "@ngrx/store-devtools": "^21.0.0-beta.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "angular-froala-wysiwyg": "^4.2.1",
    "angular2-ladda": "^5.0.0",
    "bootstrap-daterangepicker": "^3.1.0",
    "chart.js": "^4.3.3",
    "core-js": "^3.32.0",
    "d3": "^7.9.0",
    "d3-org-chart": "^3.1.1",
    "dayjs": "^1.11.9",
    "dexie": "^3.2.4",
    "fast-clean": "^1.3.1",
    "file-saver": "^2.0.5",
    "froala-editor": "^4.2.1",
    "google-libphonenumber": "^3.2.43",
    "jquery": "^3.6.4",
    "json-tree-viewer": "^0.0.2",
    "jsondiffpatch": "^0.7.3",
    "jsrsasign": "^11.1.0",
    "ladda": "^2.0.3",
    "ng-click-outside": "^9.0.0",
