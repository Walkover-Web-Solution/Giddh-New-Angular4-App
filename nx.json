{
  "npmScope": "giddh-workspaces",
  "implicitDependencies": {
    "angular.json": "*",
    "package.json": "*",
    "tsconfig.json": "*",
    "tslint.json": "*",
    "nx.json": "*"
  },
  "cli": {
    "defaultCollection": "@nx/angular",
    "analytics": "69d6b0ae-2848-419a-9569-8ea7bbf4545f"
  },
  "generators": {
    "@nx/angular:application": {
      "unitTestRunner": "jest",
      "bundler": "esbuild"
    },
    "@nx/angular:library": {
      "unitTestRunner": "jest"
    }
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "lint": {
      "cache": true
    }
  }
}
