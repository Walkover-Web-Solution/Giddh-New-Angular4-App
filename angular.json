{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "electron-giddh": {
      "root": "apps/web-giddh/",
      "sourceRoot": "apps/web-giddh/src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "index": "apps/web-giddh/src/index.html",
            "main": "apps/web-giddh/src/main.electron.ts",
            "polyfills": "apps/web-giddh/src/polyfills.ts",
            "tsConfig": "apps/web-giddh/tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "apps/web-giddh/src/assets/", "output": "/assets/" },
              { "glob": "**/*", "input": "apps/web-giddh/src/meta/", "output": "/" },
              { "glob": "favicon.ico", "input": "apps/web-giddh/src/", "output": "/" },
              { "glob": "**/*", "input": "apps/electron-giddh/src/", "output": "" }
            ],
            "styles": [
              "apps/web-giddh/src/assets/styles/main.scss",
              "node_modules/froala-editor/css/froala_editor.pkgd.min.css",
              "node_modules/froala-editor/css/froala_style.min.css",
              "node_modules/tributejs/dist/tribute.css",
              "node_modules/froala-editor/css/themes/gray.min.css"
            ],
            "scripts": [
              "node_modules/bootstrap-daterangepicker/daterangepicker.js",
              "node_modules/froala-editor/js/froala_editor.pkgd.min.js",
              "node_modules/tributejs/dist/tribute.js"
            ]
          },
          "configurations": {
            "local": {
              "outputPath": "dist/apps/web-giddh",
              "fileReplacements": [
                {
                  "replace": "apps/web-giddh/src/environments/environment.ts",
                  "with": "apps/web-giddh/src/environments/environment.local.electron.ts"
                }
              ],
              "index": { "input": "apps/web-giddh/src/index.local.html", "output": "/index.html" }
            },
            "stage": {
              "outputPath": "dist/apps/web-giddh",
              "fileReplacements": [
                {
                  "replace": "apps/web-giddh/src/environments/environment.ts",
                  "with": "apps/web-giddh/src/environments/environment.stage.ts"
                }
              ],
              "index": { "input": "apps/web-giddh/src/index.stage.html", "output": "/index.html" }
            },
            "prod": {
              "outputPath": "dist/apps/web-giddh",
              "fileReplacements": [
                {
                  "replace": "apps/web-giddh/src/environments/environment.ts",
                  "with": "apps/web-giddh/src/environments/environment.prod.electron.ts"
                }
              ],
              "index": { "input": "apps/web-giddh/src/index.electron.prod.html", "output": "/index.html" },
              "customWebpackConfig": {
                "path": "apps/web-giddh/webpack.electron.prod.partial.js",
                "mergeRules": { "externals": "replace" }
              }
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "electron-giddh:build:local",
            "host": "localhost",
            "port": 4200
          },
          "configurations": {
            "prod": {
              "buildTarget": "electron-giddh:build:prod",
              "host": "localhost",
              "port": 4200
            }
          }
        }
      }
    },
    "web-giddh": {
      "root": "apps/web-giddh/",
      "sourceRoot": "apps/web-giddh/src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/apps/web-giddh",
            "index": "apps/web-giddh/src/index.html",
            "main": "apps/web-giddh/src/main.ts",
            "polyfills": "apps/web-giddh/src/polyfills.ts",
            "tsConfig": "apps/web-giddh/tsconfig.app.json",
            "aot": true,
            "assets": [
              { "glob": "**/*", "input": "apps/web-giddh/src/assets/", "output": "/assets/" },
              { "glob": "**/*", "input": "apps/web-giddh/src/meta/", "output": "/" },
              { "glob": "favicon.ico", "input": "apps/web-giddh/src/", "output": "/" },
              { "glob": "apple-developer-domain-association.txt", "input": "apps/web-giddh/src/.well-known/", "output": "/.well-known/" }
            ],
            "styles": [
              "apps/web-giddh/src/assets/styles/main.scss",
              "node_modules/froala-editor/css/froala_editor.pkgd.min.css",
              "node_modules/froala-editor/css/froala_style.min.css",
              "node_modules/tributejs/dist/tribute.css",
              "node_modules/froala-editor/css/themes/gray.min.css"
            ],
            "scripts": [
              "node_modules/bootstrap-daterangepicker/daterangepicker.js",
              "node_modules/froala-editor/js/froala_editor.pkgd.min.js",
              "node_modules/tributejs/dist/tribute.js"
            ]
          },
          "configurations": {
            "local": {
              "outputPath": "dist/apps/web-giddh",
              "fileReplacements": [
                {
                  "replace": "apps/web-giddh/src/environments/environment.ts",
                  "with": "apps/web-giddh/src/environments/environment.local.ts"
                }
              ],
              "index": { "input": "apps/web-giddh/src/index.local.html", "output": "/index.html" }
            },
            "stage": {
              "outputPath": "dist/apps/web-giddh",
              "fileReplacements": [
                {
                  "replace": "apps/web-giddh/src/environments/environment.ts",
                  "with": "apps/web-giddh/src/environments/environment.stage.ts"
                }
              ],
              "index": { "input": "apps/web-giddh/src/index.stage.html", "output": "/index.html" }
            },
            "prod": {
              "outputPath": "dist/apps/web-giddh",
              "fileReplacements": [
                {
                  "replace": "apps/web-giddh/src/environments/environment.ts",
                  "with": "apps/web-giddh/src/environments/environment.prod.ts"
                }
              ],
              "index": { "input": "apps/web-giddh/src/index.prod.html", "output": "/index.html" }
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "web-giddh:build:local",
            "host": "localhost",
            "port": 3000
          },
          "configurations": {
            "prod": {
              "buildTarget": "web-giddh:build:prod",
              "host": "localhost",
              "port": 3000
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "74b7c6ce-2189-4755-86d1-a3a5a55f636e"
  }
}
