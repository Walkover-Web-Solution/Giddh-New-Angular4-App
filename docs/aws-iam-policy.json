{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::app-giddh-test/releases/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::app-giddh-test"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "releases/*"
          ]
        }
      }
    }
  ]
}
